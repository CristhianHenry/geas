{
    "manifest_version": 3,
    "name": "Geas Download Manager — Grab Everything At Speed",
    "short_name": "Geas",
    "version": "1.4.0",
    "description": "Envía descargas, videos y streams a Geas, un gestor de descargas que usa varias conexiones a la vez",
    "icons": {
        "16": "icons/geas-16.png",
        "32": "icons/geas-32.png",
        "48": "icons/geas-48.png",
        "128": "icons/geas-128.png"
    },
    "key": "",
    "permissions": [
        "activeTab",
        "scripting",
        "contextMenus",
        "webRequest",
        "webNavigation",
        "nativeMessaging",
        "downloads",
        "cookies",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Geas Download Manager",
        "default_icon": {
            "16": "icons/geas-16.png",
            "32": "icons/geas-32.png"
        }
    }
}
